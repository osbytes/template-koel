# Copy to .env for local Docker Compose only.

# Optional. Leave empty to auto-generate on first boot (persisted under /data/.app_key).
# Prefer setting explicitly for Railway: docker run --rm phanan/koel:9.11.0 php artisan key:generate --show
APP_KEY=

APP_URL=http://localhost:8080
FORCE_HTTPS=false
PORT=8080

DB_USERNAME=koel
DB_PASSWORD=koel_dev
DB_DATABASE=koel

# Optional scanning / integrations
MEMORY_LIMIT=
LASTFM_API_KEY=
LASTFM_API_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
